---
import { BOOK_URL, EMAIL } from '../config';
const {
  title = "Let's grow your business",
  text = "Book a free 30-minute discovery call. We'll take an honest look at where you stand online and where the biggest opportunities are.",
} = Astro.props;
const words = ["Let's grow your business", 'Content', 'Photo & video', 'Social media', 'Websites'];
---
<section class="cta-band grain" id="contact">
  <div class="marquee big-marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map((copy) => (
        <div class="marquee-set" aria-hidden={copy === 1 ? 'true' : undefined}>{words.map((w) => <span>{w}<i>✦</i></span>)}</div>
      ))}
    </div>
  </div>
  <div class="wrap cta-inner">
    <div>
      <span class="eyebrow">Free discovery call</span>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a href={BOOK_URL} class="btn btn-lg" target="_blank" rel="noopener">Book a discovery call</a>
      <a href={`mailto:${EMAIL}`} class="cta-email">{EMAIL}</a>
    </div>
  </div>
</section>
