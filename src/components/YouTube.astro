---
/* Click-to-load embed: thumbnail first, youtube-nocookie player on click (handler lives in Base.astro). */
const { id, title = 'YouTube video' } = Astro.props;
---
<div class="yt">
  <button type="button" class="yt-btn" data-yt={id} data-title={title} aria-label={`Play: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
    <span class="yt-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
  </button>
</div>
