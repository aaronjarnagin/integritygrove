---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import { BOOK_URL } from '../../config';

const work = (await getCollection('work', (e) => !e.data.draft && e.data.filters.includes('social')))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

// every number here comes from a case study or review on this site
const proof = [
  { n: '15.4M', t: "organic impressions on our clients' content last year" },
  { n: '8.1M', t: 'impressions in one year for Louie Wickett, a Des Moines loan officer' },
  { n: '500K+', t: 'views on a single post for an Ames realtor who started near zero' },
];

const process = [
  { h: 'Plan', p: 'A monthly strategy meeting: what your business needs to say, who needs to hear it, and what worked last month.' },
  { h: 'Shoot', p: 'We come to you every month and record photo and video in person. Real people, real place, no stock.' },
  { h: 'Publish', p: 'We edit everything into posts built for each platform and schedule them for when your audience is actually scrolling.' },
  { h: 'Report', p: 'A live dashboard shows what landed. Those numbers shape the next month’s plan.' },
];

const packages = [
  {
    name: 'Growth',
    text: 'A consistent presence with original content every month and clear reporting on what it is doing.',
    items: ['Monthly strategy meetings', 'Monthly content recording', '8+ custom posts per month, per platform', 'Content scheduling', 'Interactive metrics dashboard', 'Photo and video library'],
  },
  {
    name: 'Premium',
    flag: 'Most popular',
    text: 'Everything in Growth, plus more content and hands-on management of your accounts and community.',
    items: ['Account creation and optimization', 'Monthly strategy meetings', 'Monthly content recording', '16+ custom posts per month, per platform', 'Content scheduling', 'You send, we post', 'Links page management', 'Community management', 'Interactive metrics dashboard', 'Photo and video library'],
  },
];

const why = [
  { h: 'Original content, not templates', p: 'Everything we post was shot for your business. Your customers see your people, your place, and your work.' },
  { h: 'Made by the people who post it', p: 'The same two people plan, shoot, edit, and publish. No handoffs between a video crew and a social team, nothing lost in between.' },
  { h: 'Community management', p: 'Great content gets impressions. Answering messages, comments, and reviews turns those impressions into a community that trusts you.' },
  { h: 'Numbers you can read', p: 'A live dashboard of the numbers that matter, so every decision about your content is based on data, not guesses.' },
];
---
<Base title="Social Media Content & Management in Iowa | Integrity Grove" description="Content-first social media for Iowa and Midwest businesses: monthly shoots, custom posts, community management, and live metrics. From $1,500/mo.">
  <section class="page-head">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Social media content & management</span>
        <h1>Social content your customers <em>actually stop for</em></h1>
        <p class="lede">We shoot photo and video in person every month, turn it into posts made for each platform, and publish them for you. Strategy, content, posting, and reporting from one small Iowa team, for businesses across the Midwest.</p>
        <div class="hero-cta-row">
          <a href={BOOK_URL} class="btn" target="_blank" rel="noopener">Book a discovery call</a>
          <a href="#packages" class="btn btn-ghost">See packages</a>
        </div>
      </div>
      <figure class="head-img">
        <img src="/images/work/louie-wickett-social-media-content-partnership/cover.webp" alt="Social media content shoot for Louie Wickett" width="800" height="1000" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="mega-row three proof">
        {proof.map((x) => <div class="reveal"><strong>{x.n}</strong><span>{x.t}</span></div>)}
      </div>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">How it works</span>
        <h2>One team, <em>every month</em></h2>
        <p>Content-first social media means the shoot comes before the post. Here's the loop we run for every client.</p>
      </div>
      <div class="feature-grid four">
        {process.map((s, i) => (
          <div class="feature reveal">
            <span class="num">0{i + 1}</span>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="packages">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Packages</span>
        <h2>Starting at $1,500/mo</h2>
        <p>Every package includes a monthly content shoot, custom posts, scheduling, and a live metrics dashboard.</p>
      </div>
      <div class="packages">
        {packages.map((p) => (
          <div class:list={['package', 'reveal', { featured: p.flag }]}>
            {p.flag && <span class="flag">{p.flag}</span>}
            <h3>{p.name}</h3>
            <p>{p.text}</p>
            <ul class="checks">{p.items.map((i) => <li>{i}</li>)}</ul>
            <a href={BOOK_URL} class="btn" target="_blank" rel="noopener">Talk to us about {p.name}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Why us</span>
        <h2>Why content-first <em>works</em></h2>
      </div>
      <div class="feature-grid">
        {why.map((w, i) => (
          <div class="feature reveal">
            <span class="num">0{i + 1}</span>
            <h3>{w.h}</h3>
            <p>{w.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2>Content we create <em>and manage</em></h2>
        <a href="/work/?f=social" class="btn btn-ghost btn-sm">All social media work</a>
      </div>
      <div class="work-grid">{work.map((w) => <WorkCard entry={w} />)}</div>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Hear from our clients</span>
        <h2>Their success is how we measure ours</h2>
      </div>
      <Reviews limit={6} />
    </div>
  </section>
  <CtaBand />
</Base>
