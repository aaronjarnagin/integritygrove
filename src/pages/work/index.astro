---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { filterLabels } from '../../data/site';

const work = (await getCollection('work', (e) => !e.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Our Work | Integrity Grove" description="Case studies from Integrity Grove: websites, social media management, photography, and video production for banks, healthcare, fitness studios, restaurants, realtors, and more.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Our work</span>
      <h1>Real projects. <em>Real clients.</em></h1>
      <p class="lede">Websites, social media, photo, and video for businesses across Iowa and beyond. Here's what we built together and how it went.</p>
      <div class="chips" role="group" aria-label="Filter work">
        <button type="button" class="chip on" data-f="all">All</button>
        {Object.entries(filterLabels).map(([k, v]) => <button type="button" class="chip" data-f={k}>{v}</button>)}
      </div>
    </div>
  </section>
  <section class="sec sec-tight">
    <div class="wrap">
      <div class="work-grid" id="work-grid">{work.map((w) => <WorkCard entry={w} />)}</div>
    </div>
  </section>
  <CtaBand />

  <script is:inline>
    (function () {
      var chips = document.querySelectorAll('.chip');
      var cards = document.querySelectorAll('#work-grid .work-card');
      function apply(f) {
        chips.forEach(function (c) { c.classList.toggle('on', c.getAttribute('data-f') === f); });
        cards.forEach(function (c) {
          var show = f === 'all' || c.getAttribute('data-filters').split(' ').indexOf(f) > -1;
          c.hidden = !show;
          if (show) { c.style.opacity = '1'; c.style.translate = 'none'; c.style.transform = 'none'; }
        });
        // layout changed: let ScrollTrigger re-measure
        window.dispatchEvent(new Event('resize'));
      }
      chips.forEach(function (c) {
        c.addEventListener('click', function () {
          var f = c.getAttribute('data-f');
          apply(f);
          history.replaceState(null, '', f === 'all' ? location.pathname : '?f=' + f);
        });
      });
      var start = new URLSearchParams(location.search).get('f');
      if (start && document.querySelector('.chip[data-f="' + start + '"]')) apply(start);
    })();
  </script>
</Base>
