---
import Base from '../../layouts/Base.astro';
import { BOOK_URL, EMAIL, FORM_URL } from '../../config';
---
<Base title="Contact | Integrity Grove" description="Contact Integrity Grove. Book a free 30-minute discovery call or send us a message about social media, websites, photo, and video for your business.">
  <section class="page-head contact-page">
    <div class="wrap split top">
      <div>
        <span class="eyebrow">Contact us</span>
        <h1>Let's talk about <em>your business</em></h1>
        <p class="lede">Questions, a project in mind, or just want to know where you stand online? Send a message and one of us will get back to you within one business day.</p>
        <div class="contact-cards">
          <a href={BOOK_URL} class="contact-card primary" target="_blank" rel="noopener">
            <span class="eyebrow">Rather talk?</span>
            <h2>Book a free discovery call</h2>
            <p>30 minutes, no pressure. We'll take an honest look at your social media, your website, and where your competitors show up that you don't.</p>
            <span class="go">Pick a time →</span>
          </a>
          <a href={`mailto:${EMAIL}`} class="contact-card">
            <span class="eyebrow">Email</span>
            <h2>{EMAIL}</h2>
          </a>
        </div>
      </div>

      <form class="cform" data-ajax action={FORM_URL || undefined} method="POST">
        <h2>Send us a message</h2>
        <input type="hidden" name="_subject" value="New inquiry: integritygrove.com" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <div class="row">
          <div>
            <label for="cf-name">Name</label>
            <input id="cf-name" type="text" name="name" autocomplete="name" required />
          </div>
          <div>
            <label for="cf-email">Email</label>
            <input id="cf-email" type="email" name="email" autocomplete="email" required />
          </div>
        </div>
        <div class="row">
          <div>
            <label for="cf-business">Business</label>
            <input id="cf-business" type="text" name="business" autocomplete="organization" />
          </div>
          <div>
            <label for="cf-site">Website <span class="opt">(optional)</span></label>
            <input id="cf-site" type="text" name="website" inputmode="url" placeholder="yourbusiness.com" />
          </div>
        </div>
        <div>
          <label for="cf-service">What can we help with?</label>
          <select id="cf-service" name="service" required>
            <option value="">Choose one</option>
            <option>Social media management</option>
            <option>Website</option>
            <option>Photo or video</option>
            <option>Not sure yet</option>
          </select>
        </div>
        <div>
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" placeholder="Tell us a little about your business and what you're hoping to accomplish." required></textarea>
        </div>
        <button type="submit" class="btn">Send message</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>
