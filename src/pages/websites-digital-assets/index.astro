---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import { BOOK_URL } from '../../config';

const work = (await getCollection('work', (e) => !e.data.draft && e.data.filters.includes('websites')))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 6);

// every number here comes from a case study on this site (Spoke Society, Jyles FBA)
const proof = [
  { n: '1 in 4', t: 'visits to Spoke Society’s new site come straight from Google search' },
  { n: '12.84%', t: 'click rate on those search results, more than double the industry average' },
  { n: '93%', t: 'average month-over-month growth in website searches from our articles for Jyles FBA' },
];

const process = [
  { h: 'Content plan', p: 'We map the pages, the questions your customers search, and the story your site needs to tell before anything gets designed.' },
  { h: 'Design & build', p: 'A custom, fast, mobile-first site built around your own photos and video, not stock, with a clear next step on every page.' },
  { h: 'Launch & local search', p: 'Analytics, Search Console, and your Google Business Profile set up so local customers find you from day one.' },
  { h: 'Keep publishing', p: 'Articles and case studies that answer real questions and keep earning traffic long after launch day.' },
];

const packages = [
  {
    name: 'Growth',
    text: 'For small businesses that need a professional custom site that clearly shows what they do.',
    items: ['3-5 page custom website', 'Interactive metrics dashboard'],
  },
  {
    name: 'Premium',
    flag: 'Most popular',
    text: 'For growing businesses that need their site to generate leads, not just exist.',
    items: ['6-10 page custom website', 'Custom tools and features', 'Google Business Profile setup', 'Email list generation', 'Interactive metrics dashboard'],
  },
  {
    name: 'Elite',
    text: 'For established businesses that want a site built for search and ongoing content.',
    items: ['10+ page custom website', 'Custom tools and features', 'Content and articles', 'Google Business Profile setup', 'Email list generation', 'Interactive metrics dashboard'],
  },
];

const why = [
  { h: 'Built around real content', p: 'We shoot the photos and video your site needs, so it looks like your business, not a template everyone else is using too.' },
  { h: 'Search and AI search ready', p: 'Proven, ethical SEO that grows organic traffic and keeps your site showing up in Google and in AI search tools.' },
  { h: 'Found locally', p: 'An optimized Google Business Profile with accurate information, so customers in your town find you, trust you, and call or walk in.' },
  { h: 'Numbers you can read', p: 'Real-time insight into how your site performs, so we can keep improving it after launch day.' },
];
---
<Base title="Websites & SEO Content in Iowa | Integrity Grove" description="Websites for Iowa and Midwest businesses, built around your content: fast, search-ready, with articles that earn traffic and live metrics. From $1,750.">
  <section class="page-head">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Websites & SEO content</span>
        <h1>A website built to <em>put your content to work</em></h1>
        <p class="lede">Your photos, videos, and stories deserve better than a template. We build fast, custom sites around your content, then add the articles, case studies, and local search setup that keep bringing customers in.</p>
        <div class="hero-cta-row">
          <a href={BOOK_URL} class="btn" target="_blank" rel="noopener">Book a discovery call</a>
          <a href="#packages" class="btn btn-ghost">See packages</a>
        </div>
      </div>
      <figure class="head-img wide">
        <img src="/images/work/spoke-society-fishtown-philadelphia-website-build/cover.webp" alt="Spoke Society website homepage" width="1558" height="870" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="mega-row three proof">
        {proof.map((x) => <div class="reveal"><strong>{x.n}</strong><span>{x.t}</span></div>)}
      </div>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">How it works</span>
        <h2>Content first, <em>then the build</em></h2>
        <p>Most websites start with a template and fill in words later. Ours start with what your customers are searching for.</p>
      </div>
      <div class="feature-grid four">
        {process.map((s, i) => (
          <div class="feature reveal">
            <span class="num">0{i + 1}</span>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="packages">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Packages</span>
        <h2>Starting at $1,750</h2>
        <p>Launching a new site or rebuilding an old one, every package is custom-built and comes with a live metrics dashboard.</p>
      </div>
      <div class="packages three">
        {packages.map((p) => (
          <div class:list={['package', 'reveal', { featured: p.flag }]}>
            {p.flag && <span class="flag">{p.flag}</span>}
            <h3>{p.name}</h3>
            <p>{p.text}</p>
            <ul class="checks">{p.items.map((i) => <li>{i}</li>)}</ul>
            <a href={BOOK_URL} class="btn" target="_blank" rel="noopener">Talk to us about {p.name}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Why us</span>
        <h2>Why our websites <em>keep working</em></h2>
      </div>
      <div class="feature-grid">
        {why.map((w, i) => (
          <div class="feature reveal">
            <span class="num">0{i + 1}</span>
            <h3>{w.h}</h3>
            <p>{w.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2>Websites <em>we've built</em></h2>
        <a href="/work/?f=websites" class="btn btn-ghost btn-sm">All website work</a>
      </div>
      <div class="work-grid">{work.map((w) => <WorkCard entry={w} />)}</div>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Hear from our clients</span>
        <h2>Their success is how we measure ours</h2>
      </div>
      <Reviews limit={6} />
    </div>
  </section>
  <CtaBand />
</Base>
