---
/* Homepage v3: the page changes color as you scroll (data-theme per section), a drifting wall of work behind
   the hero, a scroll-lit manifesto, horizontal pinned services, stacked case studies, and a magnetic orb to close.
   v1 lives in _index-v1.astro (tag v1-classic). See CLAUDE.md "Homepage v3". */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Reviews from '../components/Reviews.astro';
import { clients, filterLabels, reviews } from '../data/site';
import { BOOK_URL, EMAIL } from '../config';

const work = (await getCollection('work', (e) => !e.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const thumb = (w: (typeof work)[number]) => w.data.cover.replace('cover.webp', 'thumb.webp');
const isShot = (w: (typeof work)[number]) => w.data.filters.every((f) => f === 'websites');
const rows = [work.slice(0, 6), work.slice(6, 12), [...work.slice(12), ...work.slice(0, 2)]];
const stack = work.slice(0, 5);

const services = [
  { n: '01', name: 'Photo & video content', href: '/work/?f=video', price: 'Per project', text: 'Commercials, brand stories, event coverage, and photo libraries, all shot and edited in-house. The raw material for everything else we do.', img: '/images/work/video-commercial-production-for-denver-savings-bank/cover.webp', alt: 'Denver Savings Bank commercial still' },
  { n: '02', name: 'Social media management', href: '/social-media-account-management/', price: 'From $1,500/mo', text: 'Monthly content shoots, custom posts, community management, and a live metrics dashboard. Your content, published where your customers scroll.', img: '/images/work/louie-wickett-social-media-content-partnership/cover.webp', alt: 'Content shoot for Louie Wickett' },
  { n: '03', name: 'Websites & SEO content', href: '/websites-digital-assets/', price: 'From $1,750', text: 'Fast, search-ready websites with articles and case studies that keep earning traffic long after launch day.', img: '/images/work/spoke-society-fishtown-philadelphia-website-build/cover.webp', alt: 'Spoke Society website' },
];

const us = ['Consistent pricing structure', 'We produce original content', 'On top of cultural trends', 'Quick & effective communication', 'We leverage new technology', 'Built-in metrics reports', "We've built audiences & businesses personally"];
const them = ['Unclear pricing structure', 'Cookie cutter content', 'Culturally out of touch', 'Ignores new features & tools', 'Not easily accessible', 'Confusing metrics', 'Have never built an audience'];
const featured = reviews.find((r) => r.name === 'Wes J')!;

const schema = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'Organization'],
  name: 'Integrity Grove',
  legalName: 'Integrity Grove, LLC',
  url: 'https://integritygrove.com',
  email: EMAIL,
  logo: 'https://integritygrove.com/images/logo-dark.png',
  description: 'Iowa content marketing agency: photo and video production, social media management, and websites for businesses across the Midwest.',
  areaServed: [
    { '@type': 'State', name: 'Iowa' },
    { '@type': 'Place', name: 'Midwestern United States' },
  ],
  knowsAbout: ['Content marketing', 'Social media marketing', 'Video production', 'Photography', 'Web design', 'SEO'],
  founder: [{ '@type': 'Person', name: 'Isaac Jarnagin' }, { '@type': 'Person', name: 'Aaron Jarnagin' }],
  sameAs: ['https://www.instagram.com/integritygrove/', 'https://www.tiktok.com/@integritygrove', 'https://twitter.com/integritygrove'],
};
---
<Base schema={schema}>
  <div class="intro" aria-hidden="true"><div class="intro-inner"><img class="intro-mark" src="/images/logo-white.png" alt="" width="1257" height="474" /></div></div>

  <div class="v3">
    <!-- HERO: headline over a tilted, drifting wall of every project -->
    <section class="hero hero3" data-theme="dark">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wall" aria-hidden="true">
        {rows.map((row, r) => (
          <div class:list={['wall-row', { reverse: r === 1 }]}>
            <div class="wall-track">
              {[0, 1].map(() => (
                <div class="wall-set">
                  {row.map((w) => (
                    <div class:list={['wall-item', { 'fit-contain': isShot(w) }]}><img src={thumb(w)} alt="" width="480" height="300" decoding="async" /></div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="hero3-inner wrap">
        <span class="eyebrow">Iowa content marketing agency · Serving the Midwest</span>
        <h1>
          <span class="l">Content marketing</span>
          <span class="l">that <em>actually grows</em></span>
          <span class="l">your business</span>
        </h1>
        <p class="lede">We make the photos, videos, and posts your customers stop scrolling for, then put them to work on social media, your website, and search. An Iowa agency for Midwest businesses, run by two brothers who built audiences of their own first.</p>
        <div class="hero-cta-row">
          <a href={BOOK_URL} class="btn btn-lg" target="_blank" rel="noopener">Book a free discovery call</a>
          <a href="#work" class="btn btn-ghost btn-lg">See the work</a>
        </div>
      </div>
      <span class="hero-scroll" aria-hidden="true">Scroll</span>
    </section>

    <!-- MANIFESTO: words light up as you scroll through them -->
    <section class="manifesto" data-theme="dark">
      <div class="wrap">
        <p class="manifesto-text" data-manifesto>Good content is the whole game. We plan it, shoot it, edit it, and publish it ourselves, then show you the numbers every month. No stock photos, no recycled templates, no junior account rep. Just two Iowa brothers who show up, in person, for businesses across the Midwest.</p>
      </div>
    </section>

    <!-- CLIENTS -->
    <section class="logos logos3" aria-label="Some clients we're proud to partner with" data-theme="dark">
      <div class="wrap"><span class="eyebrow center">Some clients we're proud to partner with</span></div>
      <div class="marquee logo-marquee">
        <div class="marquee-track">
          {[0, 1].map((copy) => (
            <div class="logo-row" aria-hidden={copy === 1 ? 'true' : undefined}>
              {clients.map((c) => <img src={c.logo} alt={copy === 1 ? '' : c.name} width={c.w} height={c.h} loading="lazy" />)}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- RESULTS: the page goes green, the number counts up -->
    <section class="mega mega3" id="results" data-theme="green">
      <div class="wrap">
        <span class="eyebrow">Results</span>
        <p class="mega-num" data-count="15450000">15,450,000</p>
        <p class="mega-cap">organic impressions on our clients' content last year, <em>with no ad spend behind them</em></p>
        <div class="mega-row">
          <div class="reveal"><strong data-count="100" data-suffix="s">100s</strong><span>of projects across dozens of industries</span></div>
          <div class="reveal"><strong data-count="500" data-suffix="K+">500K+</strong><span>views on a single post for a realtor who started near zero</span></div>
          <div class="reveal"><strong data-count="3500" data-suffix="+">3,500+</strong><span>Facebook followers built for that same client in two years</span></div>
          <div class="reveal"><strong data-count="2">2</strong><span>founders on every account. No junior reps, ever.</span></div>
        </div>
      </div>
    </section>

    <!-- SERVICES: a pinned horizontal journey through three full-screen panels -->
    <section class="hsvc" id="services" data-theme="light">
      <div class="wrap hsvc-head">
        <span class="eyebrow">What we do</span>
        <h2>Content made in-house, <em>put to work everywhere</em></h2>
      </div>
      <div class="hsvc-track">
        {services.map((s) => (
          <article class="hpanel">
            <div class="hpanel-text">
              <span class="hpanel-n">{s.n}</span>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
              <div class="hpanel-foot">
                <span class="price">{s.price}</span>
                <a href={s.href} class="btn">Learn more</a>
              </div>
            </div>
            <a href={s.href} class="hpanel-img" tabindex="-1" aria-hidden="true"><img src={s.img} alt="" width="1600" height="1100" loading="lazy" decoding="async" /></a>
          </article>
        ))}
      </div>
    </section>

    <!-- WORK: full-width cards that pin and stack (desktop), grid on mobile -->
    <section class="sec stack-sec" id="work" data-theme="light">
      <div class="wrap">
        <div class="sec-head">
          <div><span class="eyebrow">Recent work</span><h2>Real results. <em>Real clients.</em></h2></div>
          <a href="/work/" class="btn btn-ghost btn-sm">All {work.length} case studies</a>
        </div>
      </div>
      <div class="wrap stack">
        {stack.map((w, i) => (
          <a href={`/${w.id}/`} class="stack-card">
            <div class:list={['stack-img', { 'fit-contain': isShot(w) }]}><img src={w.data.cover} alt={w.data.coverAlt} width="1600" height="1000" loading="lazy" decoding="async" /></div>
            <div class="stack-body">
              <span class="stack-n">0{i + 1}</span>
              <span class="work-client">{w.data.client}{w.data.location && <span class="work-loc"> · {w.data.location}</span>}</span>
              <h3>{w.data.title}</h3>
              <p>{w.data.summary.match(/^.+?[.!?](\s|$)/)?.[0]}</p>
              <div class="pills">{w.data.filters.map((f) => <span class="pill">{filterLabels[f]}</span>)}</div>
              <span class="go">Read the case study</span>
            </div>
          </a>
        ))}
      </div>
      <div class="wrap work-grid stack-mobile">{stack.map((w) => <WorkCard entry={w} />)}</div>
    </section>

    <!-- WHY US -->
    <section class="sec" id="why" data-theme="light">
      <div class="wrap">
        <div class="sec-title reveal">
          <span class="eyebrow">Why us</span>
          <h2>Content that drives <em>real impact</em></h2>
        </div>
        <div class="compare reveal">
          <div class="col col-us grain"><h3>Integrity Grove</h3><ul>{us.map((i) => <li>{i}</li>)}</ul></div>
          <div class="col col-them"><h3>Other agencies</h3><ul>{them.map((i) => <li>{i}</li>)}</ul></div>
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    <section class="sec" id="reviews" data-theme="light">
      <div class="wrap">
        <figure class="featured-quote reveal"><blockquote>“{featured.text}”</blockquote><figcaption>{featured.name}, {featured.org}</figcaption></figure>
      </div>
      <Reviews marquee />
    </section>

    <!-- CLOSE: the page goes dark again, one giant magnetic orb -->
    <section class="orb-sec" id="contact" data-theme="dark">
      <div class="marquee big-marquee" aria-hidden="true">
        <div class="marquee-track">
          {[0, 1].map((copy) => (
            <div class="marquee-set" aria-hidden={copy === 1 ? 'true' : undefined}>{["Let's grow your business", 'Content', 'Photo & video', 'Social media', 'Websites'].map((w) => <span>{w}<i>✦</i></span>)}</div>
          ))}
        </div>
      </div>
      <div class="wrap orb-inner">
        <div>
          <span class="eyebrow">Free 30-minute discovery call</span>
          <h2>Ready when <em>you are.</em></h2>
          <p>An honest look at your content, your channels, and where the biggest opportunities are. No pitch deck, no junior rep.</p>
          <a href={`mailto:${EMAIL}`} class="cta-email">{EMAIL}</a>
        </div>
        <a href={BOOK_URL} class="orb btn" target="_blank" rel="noopener"><span>Book<br />a call</span></a>
      </div>
    </section>
  </div>
</Base>
