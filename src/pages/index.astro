---
import Base from "../layouts/Base.astro";

const services = [
  { name: "Social media account management", text: "Strategy, original content, posting, and monthly metrics reports, handled by the people who make the content." },
  { name: "Websites & digital assets", text: "Fast, clean websites and the digital assets that go with them, built to turn visitors into customers." },
  { name: "Photo & video production", text: "Commercials, event coverage, and image libraries your team can use for months." },
];

const us = [
  "Consistent pricing structure",
  "We produce original content",
  "On top of cultural trends",
  "Quick & effective communication",
  "We leverage new technology",
  "Built-in metrics reports",
  "We've built audiences & businesses personally",
];
const them = [
  "Unclear pricing structure",
  "Cookie cutter content",
  "Culturally out of touch",
  "Ignores new features & tools",
  "Not easily accessible",
  "Confusing metrics",
  "Have never built an audience",
];

const reviews = [
  { name: "Melissa Howard", text: "They've taken the chaos out of managing Google reviews and are doing a fantastic job highlighting our rural clinics in a way that actually reflects who we are." },
  { name: "Tawnia Ganzer", text: "Guthrie County State Bank has worked with Isaac for the past 3-4 years, helping us to record 2-3 events per year. The quality of product and Isaac's professionalism is second to none!" },
  { name: "Wes J", text: "Integrity Grove is outstanding in the range of their marketing expertise. Five stars, because there aren't six." },
  { name: "Casey Polizzotto", text: "They really took the time to understand our vision and brought it to life in a way that feels clean, elevated, and true to our brand." },
  { name: "Jamin Wass", text: "They've done 6 or more videos for me in the past couple years. I can be super picky about the end product and they do a phenomenal job!" },
  { name: "Jeremy Tran", text: "They've helped our business even with us being out of state. Friendly, knowledgeable, and a strong work ethic." },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "MarketingAgency",
  name: "Integrity Grove",
  url: "https://integritygrove.com",
  email: "info@integritygrove.com",
  logo: "https://integritygrove.com/images/logo-dark.png",
  sameAs: [
    "https://www.instagram.com/integritygrove/",
    "https://www.tiktok.com/@integritygrove",
    "https://twitter.com/integritygrove",
  ],
};
---
<Base schema={schema}>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Integrity Grove</span>
      <h1>Social media marketing to <em>grow your business</em></h1>
      <p class="lede">We combine creative content, strategic planning, and data-driven insights to help you connect with your audience and grow your business.</p>
      <div class="hero-cta-row">
        <a href="#contact" class="btn">Contact us</a>
        <a href="#services" class="btn btn-ghost">Our services</a>
      </div>
    </div>
  </section>

  <section class="sec tint" id="services">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Full service</span>
        <h2>Hundreds of projects, dozens of industries</h2>
        <p>Social media, websites, photo, and video, tailored to what your business actually needs.</p>
      </div>
      <div class="cards">
        {services.map((s) => (
          <div class="card reveal">
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="why">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Why us</span>
        <h2>Content that drives real impact</h2>
        <p>Unlike agencies that settle for surface-level strategies, we craft authentic brand stories that build engaged audiences and measurable results.</p>
      </div>
      <div class="compare reveal">
        <div class="col col-us">
          <h3>Integrity Grove</h3>
          <ul>{us.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="col col-them">
          <h3>Other agencies</h3>
          <ul>{them.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tint" id="reviews">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Real results. Real clients.</span>
        <h2>We're a small agency, and we like it that way</h2>
        <p>Every client gets our full attention, not a junior account rep.</p>
      </div>
      <div class="cards">
        {reviews.map((r) => (
          <figure class="card review reveal">
            <blockquote>{r.text}</blockquote>
            <figcaption>{r.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="sec contact" id="contact">
    <div class="wrap">
      <span class="eyebrow">Contact us</span>
      <h2>Let's grow your business</h2>
      <p class="lede">Tell us what you're working on and we'll get back to you.</p>
      <a href="mailto:info@integritygrove.com" class="big-email">info@integritygrove.com</a>
    </div>
  </section>
</Base>
