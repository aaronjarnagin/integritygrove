---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { clients, filterLabels } from '../data/site';
import { BOOK_URL, EMAIL } from '../config';

const work = (await getCollection('work', (e) => !e.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const reel = work.slice(0, 8);

const services = [
  { name: 'Social media management', href: '/social-media-account-management/', price: 'From $1,500/mo', text: 'Strategy, monthly content shoots, custom posts, community management, and a live metrics dashboard. Made by the people who post it.', img: '/images/work/louie-wickett-social-media-content-partnership/cover.webp' },
  { name: 'Websites & digital assets', href: '/websites-digital-assets/', price: 'From $1,750', text: 'Custom, fast, search-ready websites that tie your marketing together and give customers an easy next step.', img: '/images/work/spoke-society-fishtown-philadelphia-website-build/cover.webp' },
  { name: 'Photo & video production', href: '/work/?f=video', price: 'Per project', text: 'Commercials, event coverage, and photo libraries your team will use for months. Shot and edited in-house.', img: '/images/work/video-commercial-production-for-denver-savings-bank/cover.webp' },
];

const us = ['Consistent pricing structure', 'We produce original content', 'On top of cultural trends', 'Quick & effective communication', 'We leverage new technology', 'Built-in metrics reports', "We've built audiences & businesses personally"];
const them = ['Unclear pricing structure', 'Cookie cutter content', 'Culturally out of touch', 'Ignores new features & tools', 'Not easily accessible', 'Confusing metrics', 'Have never built an audience'];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MarketingAgency',
  name: 'Integrity Grove',
  legalName: 'Integrity Grove, LLC',
  url: 'https://integritygrove.com',
  email: EMAIL,
  logo: 'https://integritygrove.com/images/logo-dark.png',
  areaServed: 'Iowa',
  founder: [{ '@type': 'Person', name: 'Isaac Jarnagin' }, { '@type': 'Person', name: 'Aaron Jarnagin' }],
  sameAs: ['https://www.instagram.com/integritygrove/', 'https://www.tiktok.com/@integritygrove', 'https://twitter.com/integritygrove'],
};
---
<Base schema={schema}>
  <section class="hero grain">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Social media · Websites · Photo & video</span>
        <h1>Social media marketing that <em>actually grows</em> your business</h1>
        <p class="lede">Original content, real strategy, and numbers you can read. A small Iowa agency run by two brothers who built audiences of their own first.</p>
        <div class="hero-cta-row">
          <a href={BOOK_URL} class="btn btn-lg" target="_blank" rel="noopener">Book a free discovery call</a>
          <a href="/work/" class="btn btn-ghost btn-lg">See our work</a>
        </div>
        <div class="hero-meta">
          <div><b>100s</b> of projects</div>
          <div><b>Millions</b> of organic impressions</div>
          <div><b>Ames, Iowa</b> and beyond</div>
        </div>
      </div>
      <div class="hero-stack" aria-hidden="true">
        <img class="hs-1" src="/images/work/ucs-healthcare-iowa-marketing-and-social-media-partnership/cover.webp" alt="" width="800" height="600" fetchpriority="high" />
        <img class="hs-2" src="/images/work/spoke-society-fishtown-philadelphia-website-build/cover.webp" alt="" width="800" height="500" />
        <img class="hs-3" src="/images/work/catalyst-gym-social-media-success/cover.webp" alt="" width="800" height="600" />
      </div>
    </div>
    <span class="hero-scroll" aria-hidden="true">Scroll</span>
  </section>

  <section class="logos" aria-label="Some clients we're proud to partner with">
    <div class="wrap">
      <span class="eyebrow center">Some clients we're proud to partner with</span>
    </div>
    <div class="marquee logo-marquee">
      <div class="marquee-track">
        {[0, 1].map((copy) => (
          <div class="logo-row" aria-hidden={copy === 1 ? 'true' : undefined}>
            {clients.map((c) => <img src={c.logo} alt={copy === 1 ? '' : c.name} width={c.w} height={c.h} loading="lazy" />)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec tint" id="results">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Results</span>
        <h2>Numbers our clients <em>actually</em> feel</h2>
      </div>
      <div class="bento">
        <div class="tile tile-dark tile-wide reveal"><strong data-scramble>Millions</strong><span>of organic impressions for our clients last year, with zero ad spend</span></div>
        <div class="tile reveal"><strong data-count="100" data-suffix="s">100s</strong><span>of projects across dozens of industries</span></div>
        <figure class="tile tile-photo tile-tall reveal">
          <img src="/images/work/ucs-healthcare-iowa-marketing-and-social-media-partnership/cover.webp" alt="UCS Healthcare mobile clinic photographed by Integrity Grove" width="800" height="1000" loading="lazy" />
          <figcaption>UCS Healthcare, Iowa</figcaption>
        </figure>
        <div class="tile tile-green reveal"><strong data-count="500" data-suffix="K+">500K+</strong><span>views on a single post for a realtor who started near zero</span></div>
        <div class="tile reveal"><strong data-count="3500" data-suffix="+">3,500+</strong><span>Facebook followers built for that same client in two years</span></div>
        <figure class="tile tile-quote tile-wide reveal">
          <blockquote>“Five stars, because there aren't six.”</blockquote>
          <figcaption>Wes J, Google review</figcaption>
        </figure>
        <div class="tile reveal"><strong data-count="2">2</strong><span>founders on every account. No junior reps, ever.</span></div>
      </div>
    </div>
  </section>

  <section class="sec" id="services">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">What we do</span>
        <h2>A full-service agency, <em>sized for real attention</em></h2>
        <p>Social media, websites, photo, and video, tailored to what your business actually needs.</p>
      </div>
      <div class="service-list">
        {services.map((s, i) => (
          <a href={s.href} class="service reveal">
            <span class="num">0{i + 1}</span>
            <div>
              <span class="price">{s.price}</span>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </div>
            <div class="thumb" aria-hidden="true"><img src={s.img} alt="" width="440" height="330" loading="lazy" /></div>
            <span class="go">Learn more</span>
          </a>
        ))}
      </div>
      <div class="service-cta reveal">
        <a href={BOOK_URL} class="btn" target="_blank" rel="noopener">Not sure what you need? Let's talk</a>
        <span>Free 30-minute discovery call, no pitch.</span>
      </div>
    </div>
  </section>

  <!-- work reel: pinned sideways scroll on desktop (motion.ts), swipeable carousel otherwise -->
  <section class="reel" aria-label="Recent work">
    <div class="wrap reel-head">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Recent work</span>
          <h2>Real results. <em>Real clients.</em></h2>
        </div>
        <div class="reel-meta">
          <span class="reel-count" aria-hidden="true"><b>01</b> / {String(reel.length).padStart(2, '0')}</span>
          <a href="/work/" class="btn btn-ghost btn-sm">All {work.length} case studies</a>
        </div>
      </div>
    </div>
    <div class="reel-track">
      {reel.map((w, i) => (
        <a href={`/${w.id}/`} class="reel-card">
          <div class="reel-img"><img src={w.data.cover} alt={w.data.coverAlt} width="900" height="1100" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /></div>
          <div class="reel-body">
            <span class="reel-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="work-client">{w.data.client}</span>
            <h3>{w.data.title}</h3>
            <div class="pills">{w.data.filters.map((f) => <span class="pill">{filterLabels[f]}</span>)}</div>
          </div>
        </a>
      ))}
      <a href="/work/" class="reel-card reel-more">
        <span>See all {work.length}<br />case studies</span>
        <span class="reel-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="sec" id="why">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Why us</span>
        <h2>Content that drives <em>real impact</em></h2>
        <p>Unlike agencies that settle for surface-level strategies, we craft authentic brand stories that build engaged audiences and measurable results.</p>
      </div>
      <div class="compare reveal">
        <div class="col col-us">
          <h3>Integrity Grove</h3>
          <ul>{us.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="col col-them">
          <h3>Other agencies</h3>
          <ul>{them.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tint" id="reviews">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="eyebrow">Reviews</span>
        <h2>A small agency, <em>and we like it that way</em></h2>
        <p>Every client gets our full attention. These reviews reflect what we hear most: clear communication, work that moves the needle, and a team that treats your business like its own.</p>
      </div>
    </div>
    <Reviews marquee />
    <div class="wrap">
    </div>
  </section>

  <CtaBand />
</Base>
